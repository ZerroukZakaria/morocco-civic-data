{"openapi":"3.1.0","info":{"title":"Morocco Civic Data API","description":"Read-only API for Moroccan election results, down to the constituency level.\n\nVoters cast two ballots, one for a local constituency and one for a regional list, so results are always reported per ballot and shares are never mixed across them.\n\nShares are percentages of the votes cast for lists. Blank and spoilt votes are not available in the source data. Turnout rates are fractions between 0 and 1, as given by the source.\n\nData: Association Tafra, \"Résultats des élections législatives marocaines de 2021, listes locales et régionales\" (2022), licensed CC BY 4.0, copied by Tafra from elections.ma. Every results response carries its own attribution block.","version":"0.1.0"},"servers":[{"url":"http://localhost:8080","description":"Generated server url"}],"tags":[{"name":"Elections","description":"Election results at national, regional and constituency level"}],"paths":{"/api/elections":{"get":{"tags":["Elections"],"summary":"List the imported elections","operationId":"elections","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ElectionSummary"}}}}}}}},"/api/elections/{slug}":{"get":{"tags":["Elections"],"summary":"Describe one election","description":"Includes the source, the licence and the citation required to reuse the data.","operationId":"election","parameters":[{"name":"slug","in":"path","description":"Election identifier, for example legislative-2021","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ElectionDetail"}}}}}}},"/api/elections/{slug}/results":{"get":{"tags":["Elections"],"summary":"National results for one ballot","description":"Votes and vote share per list, highest first.","operationId":"results","parameters":[{"name":"slug","in":"path","description":"Election identifier, for example legislative-2021","required":true,"schema":{"type":"string"}},{"name":"ballot","in":"query","description":"Which ballot to report. Shares are never mixed across ballots.","required":false,"schema":{"type":"string","default":"LOCAL","enum":["LOCAL","REGIONAL"]}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ElectionResults"}}}}}}},"/api/elections/{slug}/regions":{"get":{"tags":["Elections"],"summary":"List the regions","description":"Constituencies counts both local and regional constituencies.","operationId":"regions","parameters":[{"name":"slug","in":"path","description":"Election identifier, for example legislative-2021","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/RegionSummary"}}}}}}}},"/api/elections/{slug}/regions/{regionId}/results":{"get":{"tags":["Elections"],"summary":"Results inside one region for one ballot","operationId":"regionResults","parameters":[{"name":"slug","in":"path","description":"Election identifier, for example legislative-2021","required":true,"schema":{"type":"string"}},{"name":"regionId","in":"path","description":"Region id, from the regions endpoint","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"ballot","in":"query","description":"Which ballot to report","required":false,"schema":{"type":"string","default":"LOCAL","enum":["LOCAL","REGIONAL"]}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ElectionResults"}}}}}}},"/api/elections/{slug}/constituencies":{"get":{"tags":["Elections"],"summary":"List constituencies, paged","description":"Returns one page of constituencies with their seats, turnout and total votes. Pages start at 0 and size is limited to 100.","operationId":"constituencies","parameters":[{"name":"slug","in":"path","description":"Election identifier, for example legislative-2021","required":true,"schema":{"type":"string"}},{"name":"ballot","in":"query","description":"Only constituencies of this ballot. All of them when omitted.","required":false,"schema":{"type":"string","enum":["LOCAL","REGIONAL"]}},{"name":"regionId","in":"query","description":"Only constituencies in this region","required":false,"schema":{"type":"integer","format":"int64"}},{"name":"page","in":"query","description":"Page number, starting at 0","required":false,"schema":{"type":"integer","format":"int32","default":0}},{"name":"size","in":"query","description":"Page size, 1 to 100","required":false,"schema":{"type":"integer","format":"int32","default":20}},{"name":"sort","in":"query","description":"Sort key: name, seats, votes or turnout","required":false,"schema":{"type":"string","default":"name"}},{"name":"direction","in":"query","description":"asc or desc","required":false,"schema":{"type":"string","default":"asc"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PagedResultConstituencySummary"}}}}}}},"/api/elections/{slug}/constituencies/{id}":{"get":{"tags":["Elections"],"summary":"One constituency with its results","description":"Votes and vote share per list inside this constituency, highest first.","operationId":"constituency","parameters":[{"name":"slug","in":"path","description":"Election identifier, for example legislative-2021","required":true,"schema":{"type":"string"}},{"name":"id","in":"path","description":"Constituency id, from the constituencies endpoint","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ConstituencyDetail"}}}}}}}},"components":{"schemas":{"ElectionSummary":{"type":"object","properties":{"slug":{"type":"string"},"name":{"type":"string"},"kind":{"type":"string"},"date":{"type":"string","format":"date"}}},"Attribution":{"type":"object","properties":{"sourceName":{"type":"string"},"sourceUrl":{"type":"string"},"licence":{"type":"string"},"licenceUrl":{"type":"string"},"citation":{"type":"string"}}},"ElectionDetail":{"type":"object","properties":{"slug":{"type":"string"},"name":{"type":"string"},"kind":{"type":"string"},"date":{"type":"string","format":"date"},"notes":{"type":"string"},"attribution":{"$ref":"#/components/schemas/Attribution"}}},"ElectionResults":{"type":"object","properties":{"election":{"type":"string"},"scope":{"type":"string"},"ballot":{"type":"string","enum":["LOCAL","REGIONAL"]},"totalVotes":{"type":"integer","format":"int64"},"basis":{"type":"string"},"lists":{"type":"array","items":{"$ref":"#/components/schemas/ListResult"}},"attribution":{"$ref":"#/components/schemas/Attribution"}}},"ListResult":{"type":"object","properties":{"code":{"type":"string"},"name":{"type":"string"},"kind":{"type":"string"},"votes":{"type":"integer","format":"int64"},"sharePercent":{"type":"number"}}},"RegionSummary":{"type":"object","properties":{"id":{"type":"integer","format":"int64"},"name":{"type":"string"},"constituencies":{"type":"integer","format":"int32"},"seats":{"type":"integer","format":"int32"}}},"ConstituencySummary":{"type":"object","properties":{"id":{"type":"integer","format":"int64"},"sourceId":{"type":"integer","format":"int32"},"name":{"type":"string"},"ballot":{"type":"string","enum":["LOCAL","REGIONAL"]},"regionId":{"type":"integer","format":"int64"},"region":{"type":"string"},"seats":{"type":"integer","format":"int32"},"turnoutRate":{"type":"number"},"totalVotes":{"type":"integer","format":"int64"}}},"PagedResultConstituencySummary":{"type":"object","properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/ConstituencySummary"}},"page":{"type":"integer","format":"int32"},"size":{"type":"integer","format":"int32"},"totalItems":{"type":"integer","format":"int64"},"totalPages":{"type":"integer","format":"int32"}}},"ConstituencyDetail":{"type":"object","properties":{"id":{"type":"integer","format":"int64"},"sourceId":{"type":"integer","format":"int32"},"name":{"type":"string"},"ballot":{"type":"string","enum":["LOCAL","REGIONAL"]},"regionId":{"type":"integer","format":"int64"},"region":{"type":"string"},"wilaya":{"type":"string"},"prefectureOrProvince":{"type":"string"},"subPrefecture":{"type":"string"},"seats":{"type":"integer","format":"int32"},"turnoutRate":{"type":"number"},"totalVotes":{"type":"integer","format":"int64"},"basis":{"type":"string"},"lists":{"type":"array","items":{"$ref":"#/components/schemas/ListResult"}},"attribution":{"$ref":"#/components/schemas/Attribution"}}}}}}